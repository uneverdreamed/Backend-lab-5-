{
  "ConnectionStrings": {
    "Catalog": "Data Source=catalog.db"
  },
  "Matching": {
    "MaxEpicenterDistanceKm": 300,
    "TimeWindowBeforeMinutes": 60,
    "TimeWindowAfterMinutes": 5,
    "ArtificialDelayMs": 0
  },
  "Simulation": {
    "SlowProbability": 0,
    "SlowDelayMs": 1500,
    "ErrorProbability": 0
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://localhost:5181",
        "Protocols": "Http2"
      },
      "GraphQL": {
        "Url": "http://localhost:5182",
        "Protocols": "Http1"
      }
    }
  },
  "Logging": {
    "OpenTelemetry": {
      "IncludeFormattedMessage": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
